# Copy this file to .env and fill in values

# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_string

# --- AI PROVIDER (optional but recommended) ---
# The app works WITHOUT this key using a smart built-in fallback generator,
# but real AI (chat tutor, richer study plans, richer quizzes) needs a free key.
#
# Recommended: Groq (free, fast, generous free tier) -> https://console.groq.com/keys
# Sign up free, create an API key, paste it below.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: if you'd rather use Google Gemini's free tier instead of Groq,
# get a key at https://aistudio.google.com/app/apikey and set these two:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
